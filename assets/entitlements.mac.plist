<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Standard Electron hardened-runtime entitlements. When a custom
       entitlements file is supplied, electron-builder no longer injects its
       defaults, so we must list them here or the app won't launch notarized. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Microphone: required under the hardened runtime for the softphone's
       getUserMedia to work (phone calls). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
